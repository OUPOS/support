---
// Force server-side rendering for dynamic subdomain support
export const prerender = false;

import { getArticles, getCategories, getHelpCenterConfig, getFolders } from '../../lib/localData';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticlePageWrapper from '../../components/ArticlePageWrapper';
import ArticleStaticContent from '../../components/ArticleStaticContent.astro';
import { prepareArticle } from '../../lib/articleContent';

const projectId = 'local';
let allArticles: any[] = [];
let categories: any[] = [];
let folders: any[] = [];
let config: any = null;
let apiSpecUrl: string | null = null;

[allArticles, categories, config, folders] = await Promise.all([
  getArticles(),
  getCategories(),
  getHelpCenterConfig(),
  getFolders(),
]);

const { slug } = Astro.params;

// Find the article by slug
const article = allArticles.find(a => a.slug === slug);

// Handle case where article is not found
if (!article) {
  return new Response(null, {
    status: 404,
    statusText: 'Not found'
  });
}

const helpCenterConfig = config;

const getCategoryName = (categoryId: string | null) => {
  if (!categoryId) return 'General';
  return categories.find(c => c.id === categoryId)?.name || 'General';
};

const formattedDate = article?.created_at 
  ? new Date(article.created_at).toLocaleDateString('en-US', {
      month: 'long',
      day: 'numeric',
      year: 'numeric'
    })
  : new Date().toLocaleDateString('en-US', {
      month: 'long',
      day: 'numeric',
      year: 'numeric'
    });

// Server-side: split BlockNote JSON out of `content` (avoids nested <script> tags
// in island props), render static HTML for crawlers / fallback, and build a real
// meta description from the article text.
const { blocks: articleBlocks, html: articleHtml, description: articleDescription, safeArticle } = prepareArticle(article);
const categoryName = getCategoryName(article.category_id);
const category = categories.find(c => c.id === article.category_id);
const categoryPath = category ? `/category/${category.id}` : undefined;

// Generate LLM copy links
const articleUrl = `${Astro.url.origin}${Astro.url.pathname}`;
---

<BaseLayout 
  title={`${article.title}｜${helpCenterConfig.portal_name}`}
  description={articleDescription}
  canonicalPath={`/article/${article.slug}`}
  breadcrumbs={[
    { name: helpCenterConfig.portal_name, path: '/' },
    ...(category ? [{ name: category.name, path: categoryPath! }] : []),
    { name: article.title, path: `/article/${article.slug}` },
  ]}
  config={helpCenterConfig}
  projectId={projectId}
  folders={folders}
  ogImage={helpCenterConfig.og_image_url}
  ogType="article"
  article={{
    publishedTime: article.created_at,
    modifiedTime: article.updated_at,
    author: helpCenterConfig.portal_name,
    section: categoryName !== 'General' ? categoryName : undefined
  }}
>
  <!-- Article content -->
  <ArticlePageWrapper
    client:only="react"
    transition:persist="article-page-wrapper"
    config={helpCenterConfig}
    article={safeArticle}
    articleBlocks={articleBlocks}
    articleHtml={articleHtml}
    categories={categories}
    allArticles={allArticles}
    categoryName={categoryName}
    articleUrl={articleUrl}
    formattedDate={formattedDate}
    projectId={projectId}
    folders={folders}
    apiSpecUrl={apiSpecUrl}
  >
    <ArticleStaticContent
      slot="fallback"
      title={article.title}
      excerpt={article.excerpt}
      html={articleHtml}
      categoryName={category?.name}
      categoryPath={categoryPath}
    />
  </ArticlePageWrapper>
</BaseLayout>
